# Copie para .env e preencha. O arquivo .env NUNCA deve ser versionado.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Usuário de acesso ao sistema
APP_USER=admin

# Hash bcrypt da senha. Gere com:  npm run hash-password   (digite a senha e Ctrl+D)
APP_PASSWORD_HASH=

# Segredo da sessão. Gere com:  openssl rand -hex 32
SESSION_SECRET=
