# /etc/systemd/system/projeto-final.service
[Unit]
Description=Projeto Final - aplicacao Node.js/Express
After=network.target

[Service]
Type=simple
User=app
Group=app
WorkingDirectory=/opt/projeto-final
EnvironmentFile=/etc/projeto-final/app.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3

# Hardening: o processo roda sem privilégios e com o sistema de arquivos somente leitura
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
